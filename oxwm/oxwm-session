#!/usr/bin/env bash
set -euo pipefail

is_vm() {
  if command -v systemd-detect-virt >/dev/null 2>&1; then
    systemd-detect-virt --quiet --vm && return 0
  fi

  local dmi_file
  for dmi_file in /sys/class/dmi/id/product_name /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/board_vendor; do
    if [[ -r "${dmi_file}" ]] && grep -qiE 'qemu|kvm|vmware|virtualbox|xen|bochs|bhyve|hyper-v|proxmox|virt' "${dmi_file}"; then
      return 0
    fi
  done

  return 1
}

pick_xrandr_output() {
  if xrandr --query | grep -q '^Virtual-1 connected'; then
    printf '%s\n' "Virtual-1"
    return
  fi

  xrandr --query | awk '/ connected/{print $1; exit}'
}

output_has_mode() {
  local output="$1"
  local mode="$2"
  xrandr --query | awk -v out="${output}" -v mode="${mode}" '
    $1 == out && $2 == "connected" { in_output = 1; next }
    in_output && $2 == "connected" { exit }
    in_output && $1 == mode { found = 1; exit }
    END { exit found ? 0 : 1 }
  '
}

set_vm_resolution() {
  local target_mode="${OXWM_VM_MODE:-1920x1080}"
  [[ -n "${DISPLAY:-}" ]] || return 0
  command -v xrandr >/dev/null 2>&1 || return 0
  is_vm || return 0

  local output
  output="$(pick_xrandr_output || true)"
  [[ -n "${output}" ]] || return 0

  if output_has_mode "${output}" "${target_mode}"; then
    xrandr --output "${output}" --mode "${target_mode}" >/dev/null 2>&1 || true
  fi
}

set_vm_resolution
if command -v variety >/dev/null 2>&1; then
  variety >/dev/null 2>&1 &
fi
exec oxwm
